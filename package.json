{
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier \"**/*.ts\" -w",
    "prelint": "pnpm --filter @swarm-tips/client lint && pnpm --filter @swarm-tips/client build",
    "lint": "prettier \"**/*.ts\" --check && tsc --noEmit -p tsconfig.lint.json",
    "test": "pnpm run test:matrix",
    "test:matrix": "npx ts-mocha -p ./tsconfig.json -t 1000000 --exit \"tests/shillbot-matrix.ts\" \"tests/game-matrix.ts\" \"tests/timeout-harness.ts\" \"tests/xchain-contested.ts\"",
    "test:unit": "npx ts-mocha -p ./tsconfig.json -t 1000000 \"tests/rpc-endpoints.test.ts\" \"tests/evm-send-retry.test.ts\" \"tests/unit/*.unit.test.ts\"",
    "ts-node": "ts-node"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.99.0",
    "@swarm-tips/client": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.19.15",
    "anchor-bankrun": "^0.5.0",
    "chai": "^4.5.0",
    "mocha": "^11.7.5",
    "prettier": "^2.8.8",
    "solana-bankrun": "^0.4.0",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.9.3",
    "viem": "^2.57.2"
  },
  "packageManager": "pnpm@10.32.1"
}
