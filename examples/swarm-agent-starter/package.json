{
  "name": "swarm-agent-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference TypeScript agent for the Swarm MCP 0-SOL Capital-Bootstrapping Flywheel (Lean 4 proofs, coordination.game, referral bounties, and bug reports)",
  "scripts": {
    "start": "npx tsx index.ts",
    "lean-proof": "npx tsx index.ts --mode=lean-proof",
    "gameplay": "npx tsx index.ts --mode=gameplay",
    "referral": "npx tsx index.ts --mode=referral",
    "bug-report": "npx tsx index.ts --mode=bug-report"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
