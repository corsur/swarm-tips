{
  "name": "@swarm-tips/contracts",
  "version": "0.1.0",
  "description": "Generated public Solana IDLs, types, program IDs, PDAs, and instruction encoding for Swarm Tips",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./idl/shillbot": "./dist/idl/shillbot.json",
    "./idl/coordination-game": "./dist/idl/coordination_game.json"
  },
  "files": [
    "dist",
    "README.md",
    "SBOM.spdx.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p .",
    "check:generated": "node scripts/sync-generated.mjs --check",
    "sync:generated": "node scripts/sync-generated.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corsur/swarm-tips.git",
    "directory": "sdk/contracts"
  },
  "homepage": "https://github.com/corsur/swarm-tips/tree/main/sdk/contracts#readme",
  "bugs": "https://github.com/corsur/swarm-tips/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
